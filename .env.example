# フロントエンド
VITE_API_BASE_URL=http://localhost:8787/v1

# Workers (wrangler secret put で設定)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET= # PKCEフローでは不要

# Google OAuth リダイレクト URI (Google Cloud Console に登録する)
# http://localhost:8787/v1/auth/callback  ← ローカル
# https://api.arcademart.pages.dev/v1/auth/callback  ← 本番

# Cloudflare リソース ID (wrangler.toml に設定)
# database_id: wrangler d1 create arcademart -> コピーしてwrangler.tomlへ
# KV id: wrangler kv:namespace create SESSIONS -> コピーしてwrangler.tomlへ
# KV id: wrangler kv:namespace create CARTS -> コピーしてwrangler.tomlへ
# R2: wrangler r2 bucket create arcademart-images
