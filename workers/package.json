{
  "name": "mamazon-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute mamazon --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute mamazon --local --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute mamazon --local --file=src/db/seed.sql",
    "db:seed:prod": "wrangler d1 execute mamazon --file=src/db/seed.sql",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.80.0"
  }
}
